  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "compaction",
    "context",
    "auto-compact"
  ],
  "license": "MIT",
  "author": "loka1",
  "homepage": "https://github.com/loka1/pi-auto-compact#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loka1/pi-auto-compact.git"
  },
  "bugs": {
    "url": "https://github.com/loka1/pi-auto-compact/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions",
    "config",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "image": "https://raw.githubusercontent.com/loka1/pi-auto-compact/main/assets/preview.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
